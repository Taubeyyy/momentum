#!/usr/bin/env node
/* Was hat GitHub Actions zuletzt mit Dopa gemacht? Die CI legt ihre Ergebnisse auf den Server
   (/var/www/momentum/releases), deshalb braucht es dafür keinen GitHub-Login.
     dopa-ci              letzter Build + Simulator-Rundgang (bei Fehlern mit Auszug aus dem Protokoll)
     dopa-ci --wait       wartet auf den nächsten Lauf (max. 9 Min, dann nochmal aufrufen)
     dopa-ci --wait 41    wartet, bis Lauf 41 fertig ist
     dopa-ci --project fakester [--wait]   dasselbe für die Fakester-App (ohne Simulator-Rundgang)      */
'use strict';
const fs = require('fs');
const path = require('path');
const argv = process.argv.slice(2);
const pi = argv.indexOf('--project');
const PROJECT = pi >= 0 ? argv.splice(pi, 2)[1] : 'dopa';
if (!['dopa', 'fakester'].includes(PROJECT)) { console.log('Unbekanntes Projekt: ' + PROJECT); process.exit(1); }
const HAS_UI = PROJECT === 'dopa';
const DIR = '/var/www/momentum/releases' + (PROJECT === 'dopa' ? '' : '/' + PROJECT);

const json = f => { try { return JSON.parse(fs.readFileSync(path.join(DIR, f), 'utf8')); } catch { return null; } };
const text = f => { try { return fs.readFileSync(path.join(DIR, f), 'utf8'); } catch { return ''; } };
const ago = at => at ? `vor ${Math.max(0, Math.round((Date.now() - at) / 60000))} Min` : '';

function state() {
  const rel = json('latest.json');                 // erfolgreicher Build: {build, notes, at}
  const failRaw = json('ci-latest-build.json');    // letzter gemeldeter Build: {run, ok, at}
  const fail = failRaw && !failRaw.ok ? failRaw : null;
  const ui = json('ci-latest-ui.json');            // Simulator-Rundgang: {run, ok, at}
  const okRun = rel ? rel.build : 0;
  const failRun = fail ? fail.run : 0;
  const build = okRun >= failRun
    ? { run: okRun, ok: true, notes: rel && rel.notes, at: rel && rel.at }
    : { run: failRun, ok: false, at: fail.at };
  return { build, ui: ui || { run: 0, ok: false } };
}

function report(s) {
  const b = s.build;
  if (b.ok) console.log(`Build ${b.run}: OK (${ago(b.at)}) – in der App als Update sichtbar. „${b.notes || ''}“`);
  else {
    console.log(`Build ${b.run}: FEHLER (${ago(b.at)}) – Protokoll: ${DIR}/ci-${b.run}-build.log`);
    console.log(text(`ci-${b.run}-build.log`).split('\n').slice(0, 60).join('\n'));
  }
  const u = s.ui;
  if (!HAS_UI) return;
  if (!u.run) console.log('Simulator-Rundgang: noch kein Ergebnis.');
  else {
    console.log(`Simulator-Rundgang ${u.run}: ${u.ok ? 'OK' : 'FEHLER'} (${ago(u.at)}) – ${DIR}/ci-${u.run}-ui.log`);
    if (!u.ok) console.log(text(`ci-${u.run}-ui.log`).split('\n').slice(0, 40).join('\n'));
  }
}

const args = argv;
if (args[0] !== '--wait') { report(state()); process.exit(0); }

const start = state();
const target = Number(args[1]) || Math.max(start.build.run, start.ui.run) + 1;
const until = Date.now() + 9 * 60 * 1000;
console.log(`Warte auf Lauf ${target} …`);
(function poll() {
  const s = state();
  if (s.build.run >= target && (!HAS_UI || s.ui.run >= target)) { report(s); process.exit(s.build.ok && (!HAS_UI || s.ui.ok) ? 0 : 1); }
  if (s.build.run >= target && !s.build.ok) { report(s); process.exit(1); }   // Build kaputt → Rundgang egal
  if (Date.now() > until) {
    console.log(`Lauf ${target} ist noch nicht fertig (Build ${s.build.run >= target ? 'fertig' : 'läuft'}, ` +
      `Rundgang ${s.ui.run >= target ? 'fertig' : 'läuft'}). Weiter warten: dopa-ci${PROJECT === 'dopa' ? '' : ' --project ' + PROJECT} --wait ${target}`);
    process.exit(2);
  }
  setTimeout(poll, 15000);
})();
